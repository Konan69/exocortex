# Copy to .env beside exo.ts. Bun loads it from the working directory, so run exo from this directory.
# Who the store belongs to: every node carries the tenant, and Jev's "about the owner" question uses the name.
EXO_TENANT=demo
EXO_OWNER=owner
EXO_OWNER_NAME="Ada Lovelace"
# Embeddings (text-embedding-3-small, 1536 dims)
OPENAI_API_KEY=
# Jev decisions and the GLM writer, through OpenRouter
OPENROUTER_API_KEY=
# Optional
# HELIX_URL=http://localhost:6972   # set it and exo never starts a local Helix itself
# EXO_MODEL=z-ai/glm-5.3-flash
# EXO_JEV_CONCURRENCY=64
# EXO_LLM_CONCURRENCY=32
# EXO_LLM_TIMEOUT=90000
