  "diagram": {
    "direction": "TB",
    "nodes": [
      { "id": "notes", "label": "Notes", "sublabel": "fixtures/notes/*.json" },
      { "id": "ingest", "label": "kb ingest", "sublabel": "4,000-char chunks" },
      { "id": "embed", "label": "Embeddings", "sublabel": "text-embedding-3-small" },
