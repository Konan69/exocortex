      { "id": "jev", "label": "Jev", "sublabel": "decides links" },
      { "id": "search", "label": "kb search", "sublabel": "graph + BM25" }
    ],
    "edges": [
      { "from": "notes", "to": "ingest", "label": "files" },
      { "from": "ingest", "to": "embed", "label": "chunks" },
      { "from": "embed", "to": "helix", "label": "vectors" },
      { "from": "helix", "to": "jev", "label": "candidates" },
      { "from": "jev", "to": "helix", "label": "MENTIONS" },
      { "from": "helix", "to": "search", "label": "walk" }
    ],
    "primary": ["notes", "ingest", "embed", "helix", "search"]
  }
