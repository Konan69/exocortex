      { "text": "Serving on http://localhost:8421/bookmarks.html", "style": "accent" },
      { "text": "$ curl -s 'localhost:8421/api/bookmarks?search=greenhouse' | jq -r '.[].id'", "style": "muted" },
      { "text": "demo:compost-soil" },
      { "text": "demo:garden-sensors" },
      { "text": "demo:greenhouse-irrigation" },
      { "text": "demo:rainwater-tank" },
      { "text": "demo:solar-greenhouse" }
